{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inkwire-education",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/account", "/account.html", "/teacher*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "APP_ORIGIN": "https://inkwire-education.com",
    "ACCOUNT_EMAIL": "accounts@inkwire-education.com",
    "ACCOUNTS_ENABLED": "true"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "inkwire-education",
    "database_id": "8fbdd8d5-8653-4fb8-939b-9afd4f671e24",
    "migrations_dir": "cloudflare/migrations"
  }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["accounts@inkwire-education.com"] }],
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
