{
  "name": "inkwire-learning-studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/notebook-editor.js --bundle --minify --format=iife --target=es2020 --outfile=dist/notebook-editor.js --legal-comments=linked && node scripts/notebook-licenses.mjs && node scripts/build-invitations.mjs && node scripts/build-worksheets.mjs && node scripts/build-notebooks.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser/*.browser.cjs"
  },
  "dependencies": {
    "@liveblocks/client": "3.24.5",
    "@liveblocks/yjs": "3.24.5",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/y-tiptap": "3.0.7",
    "better-auth": "1.7.14",
    "qrcode-generator": "2.0.4",
    "yjs": "13.6.27",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "wrangler": "4.156.0"
  }
}
