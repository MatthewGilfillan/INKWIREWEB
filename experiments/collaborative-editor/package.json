{
  "name": "folio-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pdf-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/pdf-assets.mjs && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/worksheet-model.test.js tests/rich-text.test.js",
    "test:browser": "node --test tests/worksheet.browser.js"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-highlight": "3.32.1",
    "@tiptap/extension-text-align": "3.32.1",
    "@tiptap/extension-text-style": "3.32.1",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.6.205",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
